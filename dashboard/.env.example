# Copy to .env.local and fill in. Never commit .env.local.
#   chmod 600 dashboard/.env.local

# Discord Developer Portal -> your app -> OAuth2
# Add these redirect URLs there first:
#   https://vibe-y.us/api/auth/callback/discord
#   http://localhost:3100/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Same bot token the Python bot uses (Vibey/.env DISCORD_TOKEN).
# Server-side only — used to look up who has the admin role.
DISCORD_BOT_TOKEN=

# openssl rand -base64 32
AUTH_SECRET=

# Public origin. Leave as localhost until DNS for vibe-y.us is live.
AUTH_URL=http://localhost:3100

# The one guild with real activity, and the role main.py treats as admin.
VIBEY_GUILD_ID=1431565435010289778
VIBEY_ADMIN_ROLE_ID=1431565435819528302
