[Unit]
Description=Vibey Dashboard (Next.js)
Documentation=file:///home/tmthy/Vibey/dashboard/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tmthy
Group=tmthy
WorkingDirectory=/home/tmthy/Vibey/dashboard

# 3000 is taken by the survivor-app.org site already behind the same tunnel.
Environment=NODE_ENV=production
Environment=PORT=3100
EnvironmentFile=/home/tmthy/Vibey/dashboard/.env.local

# Absolute path to the nvm Node, not `npm run start`.
# /usr/bin/node on this Pi is v18; the build targets the v20 that nvm provides
# and that an interactive shell picks up. systemd gets no shell and no nvm
# init, so it would silently run the wrong runtime. vibeymusic.service pins the
# same path for the same reason. Calling next's binary directly also drops the
# npm wrapper process, so systemd supervises the server itself.
ExecStart=/home/tmthy/.nvm/versions/node/v20.20.0/bin/node /home/tmthy/Vibey/dashboard/node_modules/next/dist/bin/next start -p 3100
Restart=always
RestartSec=5
# Give up and stay down if it crash-loops, rather than hammering a Pi that is
# also running four Discord bots.
StartLimitIntervalSec=120
StartLimitBurst=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=vibey-dashboard

# --- Hardening -------------------------------------------------------------
# The dashboard holds the bot token and is the one process here reachable from
# the internet, so it gets the tightest sandbox that still lets it work.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
# AF_NETLINK is required: Node enumerates network interfaces at startup via
# uv_interface_addresses(), which uses a netlink socket on Linux. Without it
# the process dies with a bare "Unknown system error 97" before serving
# anything. It grants no network reach — netlink is kernel-local.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

# ProtectHome=read-only makes the whole home tree read-only; these are the only
# places the process legitimately writes.
ReadWritePaths=/home/tmthy/Vibey/dashboard/data
ReadWritePaths=/home/tmthy/Vibey/dashboard/.next

# The bot's automations database. The one thing outside the dashboard's own
# directory it may write, and the exception is deliberate: an automation built
# on the website has to be one the engine actually runs, which means writing
# where the engine reads. See lib/automations/store.ts.
#
# It is a directory rather than a file because SQLite in WAL mode writes three
# of them — a grant on the .db alone yields SQLITE_CANTOPEN the moment anything
# writes, because the -wal and -shm siblings cannot be created. That is exactly
# why this database lives in a directory of its own instead of beside the other
# fourteen: this grant must not reach any of them, or the bot's economy,
# tickets and audit log would all be writable by the internet-facing process.
ReadWritePaths=/home/tmthy/Vibey/data/automations

# The shared Economy/Leveling config bridge, same reasoning and shape as the
# grants around it. See lib/bot/economy-config.ts and cogs/economy/config_sync.py.
ReadWritePaths=/home/tmthy/Vibey/data/economy_config

# The shared per-guild module config bridge (welcome, security, suggestions).
# Same reasoning and same shape as the automations grant above: a directory of
# its own, because WAL writes three files, and because a broader grant would
# expose the bot's other databases to the internet-facing process. See
# lib/bot/module-config.ts and utils/module_config_sync.py.
ReadWritePaths=/home/tmthy/Vibey/data/module_config

# The ticketing config bridge (topics, panels, responses). Same reasoning and
# same shape as the grants above: a directory of its own, because WAL writes
# three files, and because a broader grant would expose the bot's other
# databases to the internet-facing process. See lib/ticketing/store.ts and
# cogs/ticketing/config_sync.py.
ReadWritePaths=/home/tmthy/Vibey/data/ticketing_config

# The QOTD question-pool bridge (add/edit/delete questions, tomorrow's queued
# question). Same reasoning and same shape as the grants above: a directory of
# its own, because WAL writes three files, and because a broader grant would
# expose the bot's other databases to the internet-facing process. QOTD's flat
# settings ride the module_config bridge above instead. See lib/qotd/store.ts
# and cogs/qotd_config_sync.py.
ReadWritePaths=/home/tmthy/Vibey/data/qotd_config

# The Utility database (reminders, one-off messages, stickies, reaction rules,
# media channels). Same reasoning and same shape as the grants above: a
# directory of its own, because WAL writes three files, and because a broader
# grant would expose the bot's other databases to the internet-facing process.
# See lib/utility/store.ts and cogs/utility/storage.py.
ReadWritePaths=/home/tmthy/Vibey/data/utility
ReadWritePaths=/home/tmthy/Vibey/data/custom_commands

# The Welcome & Onboarding bridge (intro question pool, blacklist, per-member
# points, ranked lists, game→LFG mappings). Same reasoning and same shape as the
# grants above: a directory of its own, because WAL writes three files, and a
# broader grant would expose the bot's other databases to the internet-facing
# process. Onboarding's flat settings ride the module_config bridge above
# instead. See lib/onboarding/store.ts and cogs/onboarding_config_sync.py.
ReadWritePaths=/home/tmthy/Vibey/data/onboarding_config

# The Custom Matches command bridge (edit a game, adjust a player's MMR, clear a
# penalty …). Same reasoning and same shape as the grants above: a directory of
# its own, because WAL writes three files, and a broader grant would expose the
# bot's other databases to the internet-facing process. This is the *write* half
# only — the module reads custommatch.db directly, read-only, which needs no
# grant under ProtectSystem=strict. See lib/custommatch/store.ts and
# cogs/custommatch_config_sync.py.
ReadWritePaths=/home/tmthy/Vibey/data/custommatch_config

# The Roles & Alerts store (per-guild config.json plus a commands.db of role
# shuffles). Same reasoning and same shape as the grants above: a directory of
# its own, because SQLite in WAL mode writes three files and a broader grant
# would expose the bot's other databases to the internet-facing process. See
# lib/roles-and-alerts/store.ts.
ReadWritePaths=/home/tmthy/Vibey/data/roles_and_alerts_config

# The Game Poll database (game library, vote ledger, and the draft the dashboard
# hands the cog to post). Same reasoning and same shape as the grants above. See
# lib/game-poll/store.ts.
ReadWritePaths=/home/tmthy/Vibey/data/game_poll_config

# Comfortably above the ~200MB it actually uses; a leak gets killed rather than
# taking the bots down with it.
MemoryMax=1G

[Install]
WantedBy=multi-user.target
